# Program 1 - enumerate()

name="nivetha"

for index,letter in enumerate(name):
    print(index,letter)

# Output
# 0 n
# 1 i
# 2 v
# 3 e
# 4 t
# 5 h
# 6 a


# Program 2 - enumerate(start=1)

name="python"

for index,letter in enumerate(name,start=1):
    print(index,letter)

# Output
# 1 p
# 2 y
# 3 t
# 4 h
# 5 o
# 6 n


# Program 3 - zip()

name=["Ram","Sam","Hari"]
age=[20,21,22]

for n,a in zip(name,age):
    print(n,a)

# Output
# Ram 20
# Sam 21
# Hari 22


# Program 4 - zip() with 3 lists

my1=[1,2,3]
my2=[10,20,30]
my3=[100,200,300]

for item in zip(my1,my2,my3):
    print(item)

# Output
# (1, 10, 100)
# (2, 20, 200)
# (3, 30, 300)


